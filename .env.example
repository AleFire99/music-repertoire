POSTGRES_USER=repertoire
POSTGRES_PASSWORD=repertoire
POSTGRES_DB=repertoire
DATABASE_URL=postgresql+psycopg://repertoire:repertoire@postgres:5432/repertoire

# Host port overrides — only needed when running docker compose from more than one
# git worktree at once (parallel feature development). Give each worktree's .env
# distinct values; leave unset for the main checkout to use the defaults below.
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173
